rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profile: owner-only read/write.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Standalone tasks live under the user doc — owner-only, no per-doc checks.
      match /standalone_tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Saved assistant conversations — owner-only, bounded in shape and size.
      match /chats/{chatId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['title', 'createdAt', 'updatedAt', 'turns'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.turns is list
          && request.resource.data.turns.size() <= 100;
      }
      // Browser push subscriptions are private to the signed-in account. The
      // reminder function POSTs to the stored endpoint, so only the browser
      // vendors' push services are accepted (keep in sync with
      // functions/src/push-endpoint.ts).
      match /pushSubscriptions/{subscriptionId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches(
            '^https://([a-z0-9-]+\\.)*(fcm\\.googleapis\\.com|push\\.services\\.mozilla\\.com|notify\\.windows\\.com|push\\.apple\\.com)(/.*)?$'
          );
      }
    }
    // Events: owner-scoped. Subcollections (tasks, schedule) inherit via
    // the parent event's ownership check.
    match /events/{eventId} {
      allow read, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      match /tasks/{taskId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
        allow create: if request.auth != null
          && getAfter(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
      }

      match /schedule/{entryId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
        allow create: if request.auth != null
          && getAfter(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
