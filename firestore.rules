rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profile: owner-only read/write.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Standalone tasks live under the user doc — owner-only, no per-doc checks.
      match /standalone_tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Browser push subscriptions are private to the signed-in account.
      match /pushSubscriptions/{subscriptionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Events: owner-scoped. Subcollections (tasks, schedule) inherit via
    // the parent event's ownership check.
    match /events/{eventId} {
      allow read, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      match /tasks/{taskId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
        allow create: if request.auth != null
          && getAfter(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
      }

      match /schedule/{entryId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
        allow create: if request.auth != null
          && getAfter(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
