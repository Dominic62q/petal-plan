# Public Firebase Web App configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public Web Push key. Never add VAPID_PRIVATE_KEY to this file.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Assistant (server only; never prefix these with NEXT_PUBLIC_) ---
# API key from your OpenCode Go plan. It is read by the Next.js server process
# on your own machine and never sent to the browser. This is the only thing
# you need to run the assistant locally.
OPENCODE_API_KEY=
# Optional. Defaults shown.
# OPENCODE_MODEL=deepseek-v4.1-flash
# OPENCODE_BASE_URL=https://opencode.ai/inference/go
# Individual users have no limit. This one ceiling, counted in model calls per
# UTC day across everyone, protects the shared plan.
# ASSISTANT_GLOBAL_DAILY_LIMIT=3000
# Only for a hosted deployment: a Firebase service account (JSON or base64).
# With it, usage is counted in Firestore and survives restarts.
# FIREBASE_SERVICE_ACCOUNT=
